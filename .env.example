# Servidor: nunca con prefijo NEXT_PUBLIC_
SUPABASE_URL=                 # URL del proyecto (https://xxx.supabase.co)
SUPABASE_SERVICE_ROLE_KEY=    # llave secreta (sb_secret_...). Solo la lee lib/supabase-server.ts
CRM_API_TOKEN=                # token del CRM; lo usa lib/crm.ts dentro de after()
META_PIXEL_ID=                # ID del píxel de Meta; lo usa lib/capi.ts
META_CAPI_TOKEN=              # token de la Conversions API; lo usa lib/capi.ts dentro de after()

